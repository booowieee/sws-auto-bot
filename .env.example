# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ADMIN_ID=your_telegram_user_id_here

# Runtime settings
CHROME_PERSISTENT_PROFILE_DIR=data/chrome_profile
HEADLESS=true
ACTION_TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=30000

# LLM Fallback (Tier 2 - for unmapped fields)
LLM_FALLBACK_ENABLED=true

# Primary: Google Gemini (recommended)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Secondary: Groq (optional fallback)
# GROQ_API_KEY=your_groq_api_key_here

# Tertiary: OpenAI (optional fallback)
# OPENAI_API_KEY=your_openai_api_key_here

# Local: Ollama (optional offline fallback)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2:3b
